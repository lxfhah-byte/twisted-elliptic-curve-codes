def tecc_counts(F, D, k, V):
    D = [(F(x), F(y)) for x,y in D]
    V = [tuple(F(s) for s in v) for v in V]
    n = len(D)
    assert len(set(D)) == n and 3 <= k and k+1 < n
    assert len(set(V)) == len(V)
    assert all(len(v) == n and all(v) for v in V)
    def p(j, x, y):
        return x**(j//2) if j%2 == 0 else y*x**((j-3)//2)
    counts = [0]*5
    top = [p(k+1,x,y) for x,y in D]
    last = (k-3)//2 if k%2 else k//2
    for ell in range(last+1):
        h = 2*ell + (3 if k%2 else 0)
        for eta in F:
            if not eta:
                continue
            rows = [[p(j,x,y) + (eta*top[i] if j == h else 0)
                     for i,(x,y) in enumerate(D)]
                    for j in [0]+list(range(2,k+1))]
            G = matrix(F,rows)
            assert G.rank() == k and G.ncols() == n
            d = min(sum(bool(z) for z in a*G)
                    for a in VectorSpace(F,k) if any(a))
            defect = n-k+1-d
            assert defect in (0,1,2)
            for v in V:
                scaled = G*diagonal_matrix(F,v)
                sd = (n == 2*k and (scaled*scaled.transpose()).is_zero())
                counts[defect] += 1
                counts[3] += int(sd)
                counts[4] += int(sd and defect == 0)
    return counts

F = GF(5)
D = [(x,y) for x in F for y in F if y*y == x**3+x+1]
assert tecc_counts(F,D,3,[[1]*len(D)]) == [0,2,2,0,0]
